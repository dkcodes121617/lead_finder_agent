# GENERATED by tools/make_env_example.py from this folder's .env.
# Do not hand-edit: edit .env, then regenerate. Secret values are blanked.
# Copy to .env and fill in every empty value.
# ═══════════════════════════════════════════════════════════════════════════
# Lead Finder — environment  (REAL VALUES · SELF-CONTAINED)
# ═══════════════════════════════════════════════════════════════════════════
# Complete on its own: this agent deploys independently and reads nothing from
# outside its own folder.
#
# Production mirror: the Modal secret `wizcodes-leadfind` (see deploy.ps1).
# Run `python shared/check_env.py` after any rotation — it fails on drift
# between the cross-agent keys below.
#
# THE HARD RULE, restated where it will be read: this agent performs NO write
# action on ANY platform. No comment, no reply, no DM, no vote, ever, including
# after a delay. No variable below turns that on, and adding one is not a
# configuration change — it is a different system with a different risk profile.
# ═══════════════════════════════════════════════════════════════════════════

# ── Claude-compatible proxy (ClaudeStore) ──
ANTHROPIC_BASE_URL=https://api3.claudestore.store
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4.6
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4.5
ANTHROPIC_STRATEGY_MODEL=claude-opus-4-8

# ── Neon Postgres (Postgres 18) ──
# This agent is the SOLE WRITER of core.leads. It owns `leadfind.*` and
# checkpoints into `lf_ckpt`.
NEON_DATABASE_URL=
LANGGRAPH_CHECKPOINT_SCHEMA=lf_ckpt

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TOPIC_LEADS=
TELEGRAM_TOPIC_ALERTS=
TELEGRAM_CALLBACK_PREFIX=lf

# ── Site repo (grounding facts, READ-ONLY) ──
# Needed for the canonical service-line names. Hardcoding them here would mean
# the day a fourth service ships, two agents are silently wrong.
# TODO — CREATE. Fine-grained PAT, Contents: READ ONLY, this repo only.
SITE_REPO=dkcodes121617/wizcodes_main_website
SITE_REPO_BRANCH=main
SITE_READ_TOKEN=

# ── Groq (free tier) ──
# TODO — CREATE at console.groq.com, no card. THE critical gap for this agent:
# without it nothing gets classified. Free-tier limits are per ACCOUNT, so this
# budget is shared with the Outreach agent whether or not the key is.
GROQ_API_KEY=

# ── Behaviour ──
LOG_LEVEL=INFO
DRY_RUN=1
DISPLAY_TZ=Asia/Kolkata

# ═══════════════════════════════════════════════════════════════════════════
# Agent-specific
# ═══════════════════════════════════════════════════════════════════════════

# ── Which sources are live ──
# An absent source is skipped without error. Starts with the two that need no
# key and carry no vendor risk; add the rest one at a time as each is verified.
SOURCES_ENABLED=inbound,hackernews,reddit,twitter,stackexchange,places,osm

# ── Reddit (read/search endpoints only) ──
REDDITAPIS_KEY=
REDDITAPIS_BASE_URL=https://api.redditapis.com
REDDIT_BACKEND=redditapis
# TODO — OPTIONAL. The official-app fallback. Reddit declined the commercial
# use request, so this path stays unused; PRAW is installed and the interface
# exists so the swap is a config change, not a build under pressure.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:site.wizcodes.leadfinder:v1.0 (by /u/wizcodes)
SUBREDDITS=smallbusiness,Entrepreneur,startups,SaaS,webdev,nocode,dentistry,restaurateur,realtors,shopify,ecommerce,indiehackers

# ── X / Twitter (read only) ──
TWITTERAPIS_KEY=
TWITTERAPIS_BASE_URL=https://api.twitterapis.com
TWITTER_QUERIES=looking for a developer,need a website built,our website is outdated,hire an app developer,automate this manually

# ── Hacker News (Algolia — no key needed) ──
HN_BASE_URL=https://hn.algolia.com/api/v1
HN_QUERIES=looking for developer,need help building,freelance developer,mvp help

# ── Stack Exchange ──
STACKEXCHANGE_KEY=
STACKEXCHANGE_SITES=stackoverflow,webmasters,softwareengineering
STACKEXCHANGE_TAGS=web-development,api,automation,wordpress,shopify

# ── Cold business discovery (owned by THIS agent) ──
# All lead CREATION lives here so there is exactly one dedup authority.
# Outreach is a pure consumer.
#
# TODO — CREATE. console.cloud.google.com, enable Places API (New), restrict
# the key to that API. Card required.
# COST WARNING, verified: `websiteUri` is an ENTERPRISE-tier field, and a
# request bills at the highest tier any requested field belongs to. Every
# discovery call is therefore an Enterprise call — free ceiling ~1,000/month,
# not the 10,000 the source doc assumed.
GOOGLE_PLACES_API_KEY=
DISCOVERY_QUERIES=dentists in Austin TX,law firms in Manchester UK,restaurants in Dublin IE,physiotherapists in Boston MA,accountants in Leeds UK
PLACES_MAX_CALLS_PER_RUN=60
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Inbound (the highest-intent source in the system) ──
# Wico AI conversations and contact-form submissions, via core.inbound_events.
# These people came to YOU: seeded at intent_score 95, so they always sort
# above anything found by scanning.
INBOUND_MIN_SCORE=0

# ── Classification ──
CLASSIFIER_PROVIDER=proxy
GROQ_CLASSIFY_MODEL=llama-3.3-70b-versatile
# Governs interruption, not capture: everything is stored and reachable via
# /open regardless.
NOTIFY_MIN_SCORE=55
MAX_CANDIDATES_PER_RUN=300

# ── Cadence ──
# Cron lives in modal_app.py. Read ARCHITECTURE.md §7.1 before shortening the
# interval: at 15 minutes this agent alone consumes ~66% of Neon's 100 CU-hour
# free month, because every wake-up holds compute alive through a 5-minute
# autosuspend window it cannot shorten on the free plan. 30 minutes ≈ 33 CU-h.
LOOKBACK_MINUTES=45
REDDITAPIS_POSTS_PATH=/api/reddit/posts
ANTHROPIC_FALLBACK_CLASSIFY_MODEL=claude-haiku-4.5
LLM_PROVIDER=proxy
